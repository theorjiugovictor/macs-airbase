# MACS Airbase — Caddy reverse proxy with automatic HTTPS
#
# Routes:
#   /ws          → WebSocket backend (bidirectional)
#   /field/*     → Field PWA (mobile app for ground crews)
#   /health      → Health check
#   /api/*       → API endpoints
#   /            → Redirect to /field/

{$DOMAIN} {
    # ── WebSocket — proxied to backend ──────────────────────────────────
    handle /ws {
        reverse_proxy backend:8765
    }

    # ── Health check ────────────────────────────────────────────────────
    handle /health {
        respond "OK" 200
    }

    # ── API info ────────────────────────────────────────────────────────
    handle /api/info {
        header Content-Type "application/json"
        respond `{"service":"MACS Airbase","version":"2.1","ws":"/ws","field":"/field/","docs":"https://github.com/theorjiugovictor/macs-airbase"}` 200
    }

    # ── HTTP API for ElevenLabs voice agent ───────────────────────────
    handle_path /api/* {
        reverse_proxy backend:8080
    }

    # ── Field PWA — mobile app ──────────────────────────────────────────
    handle /field/* {
        uri strip_prefix /field
        root * /srv/field
        file_server
        try_files {path} /index.html
    }

    # ── Root redirect → field app ───────────────────────────────────────
    handle / {
        redir /field/ permanent
    }

    # ── CORS headers ────────────────────────────────────────────────────
    header {
        Access-Control-Allow-Origin  *
        Access-Control-Allow-Methods "GET, POST, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization"
    }

    # ── Logging ─────────────────────────────────────────────────────────
    log {
        output stdout
        format console
    }
}
