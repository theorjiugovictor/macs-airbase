# SABRE — Caddy reverse proxy with automatic HTTPS via Duck DNS
#
# Caddy automatically provisions Let's Encrypt TLS certificates.
# The {$DOMAIN} env var is set in docker-compose.prod.yml (e.g. sabre.duckdns.org)

{$DOMAIN} {
    # WebSocket endpoint — proxied to the backend container
    handle /ws {
        reverse_proxy backend:8765
    }

    # Health check endpoint
    handle /health {
        respond "OK" 200
    }

    # Everything else → show a simple info page (or proxy to a frontend)
    handle {
        header Content-Type "application/json"
        respond `{"service":"SABRE","status":"online","ws":"/ws","docs":"https://github.com/princeorjiugo/macs-airbase"}` 200
    }

    # CORS headers for Lovable frontend (or any external frontend)
    header {
        Access-Control-Allow-Origin  *
        Access-Control-Allow-Methods "GET, POST, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization"
    }

    # Logging
    log {
        output stdout
        format console
    }
}
