# ─────────────────────────────────────────────────────────────────────────────
# SABRE — Production environment variables
# Copy to .env and fill in your values:  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Duck DNS
DOMAIN=macs-airbase.duckdns.org
DUCKDNS_TOKEN=your-duckdns-token-here
DUCKDNS_SUBDOMAIN=macs-airbase

# LLM API Keys (pick one — runs in mock mode if all empty)
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# OpenRouter model (default: google/gemini-2.5-flash)
# See https://openrouter.ai/models for options
OPENROUTER_MODEL=google/gemini-2.5-flash

# Scenario: surge | scramble | disperse
SCENARIO=surge
